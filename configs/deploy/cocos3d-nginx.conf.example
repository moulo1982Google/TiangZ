# TiangZ Cocos3D 双入口示例。
# Example Nginx layout for the TiangZ Cocos3D desktop and mobile entry points.
#
# 上传前先执行 npm run build:cocos3d:external，然后：
#   build/external/desktop/* -> /var/www/tiangz-cocos3d/desktop/
#   build/external/m/*       -> /var/www/tiangz-cocos3d/m/

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/tiangz-cocos3d/desktop;
    index index.html;

    # /m 没有尾斜杠时统一跳到 /m/，保证相对资源路径稳定。
    # Normalize /m to /m/ so the mobile bundle keeps its relative asset paths.
    location = /m {
        return 301 /m/;
    }

    # Mobile Web is the only landscape entry point.
    location ^~ /m/ {
        root /var/www/tiangz-cocos3d;
        try_files $uri $uri/ /m/index.html;
        # 外网机仅用于Demo，所有资源每次使用前都向服务器确认版本，避免iOS桌面Web App长期保留旧包。
        # The public host is a Demo server; always revalidate assets so an iOS Home Screen app cannot retain an old build.
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
    }

    # Desktop Web stays at the normal root entry point.
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
    }
}

# 外网游戏入口只暴露 Nginx 端口，TiangZ 进程监听独立的回环端口。
# The public game ports terminate at Nginx; TiangZ listens on separate loopback ports.
#
# 这样不会出现 Nginx 和 TiangZ 同时抢占同一个端口的问题。当前外网客户端使用
# WebSocket，HTTP 反向代理可以透传升级握手和后续二进制帧；内部 Process 之间
# 仍然直接使用 127.0.0.1 的 inner TCP，不会绕过 Nginx。
#
# Public -> loopback:
#   17000 -> 27000  login_mgr
#   17001 -> 27001  login_1
#   17002 -> 27002  login_2
#   17201 -> 27201  gate_1
#   17202 -> 27202  gate_2

server {
    listen 17000;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:27000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_connect_timeout 5s;
        proxy_buffering off;
    }
}

