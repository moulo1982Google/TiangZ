# TiangZ Cocos3D HTTPS/WSS production entry for the current external IP.
# Certificates are provisioned on the host and must never be committed.

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name 14.103.24.32;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name 14.103.24.32;

    ssl_certificate /etc/letsencrypt/live/14.103.24.32/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/14.103.24.32/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TiangZTLS:10m;
    ssl_session_timeout 10m;

    root /var/www/tiangz-cocos3d/desktop;
    index index.html;
    add_header Strict-Transport-Security "max-age=86400" always;

    location = /m {
        return 301 /m/;
    }

    location ^~ /m/ {
        root /var/www/tiangz-cocos3d;
        try_files $uri $uri/ /m/index.html;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Strict-Transport-Security "max-age=86400" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
    }
}

# Public WSS endpoints terminate TLS here. TiangZ continues to listen on
# loopback-only plain WebSocket ports; inner TCP never passes through Nginx.
# 17000 -> 27000 LoginMgr, 17001 -> 27001 Login 1, 17002 -> 27002 Login 2,
# 17201 -> 27201 Gate 1, 17202 -> 27202 Gate 2.

server {
    listen 17000 ssl;
    server_name 14.103.24.32;
    ssl_certificate /etc/letsencrypt/live/14.103.24.32/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/14.103.24.32/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / { proxy_pass http://127.0.0.1:27000; include /etc/nginx/snippets/tiangz-websocket.conf; }
}

server {
    listen 17001 ssl;
    server_name 14.103.24.32;
    ssl_certificate /etc/letsencrypt/live/14.103.24.32/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/14.103.24.32/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / { proxy_pass http://127.0.0.1:27001; include /etc/nginx/snippets/tiangz-websocket.conf; }
}

server {
    listen 17002 ssl;
    server_name 14.103.24.32;
    ssl_certificate /etc/letsencrypt/live/14.103.24.32/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/14.103.24.32/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / { proxy_pass http://127.0.0.1:27002; include /etc/nginx/snippets/tiangz-websocket.conf; }
}

server {
    listen 17201 ssl;
    server_name 14.103.24.32;
    ssl_certificate /etc/letsencrypt/live/14.103.24.32/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/14.103.24.32/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / { proxy_pass http://127.0.0.1:27201; include /etc/nginx/snippets/tiangz-websocket.conf; }
}

server {
    listen 17202 ssl;
    server_name 14.103.24.32;
    ssl_certificate /etc/letsencrypt/live/14.103.24.32/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/14.103.24.32/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / { proxy_pass http://127.0.0.1:27202; include /etc/nginx/snippets/tiangz-websocket.conf; }
}
