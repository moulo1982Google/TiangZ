{
  "process": {
    "name": "external_manager",
    "identity": { "originServerId": 1, "workerId": 8 },
    "lifecycle": { "restart": { "maxAttempts": 5, "windowMs": 600000, "backoffMs": 5000 } },
    "logging": { "level": "info", "format": "json", "console": true, "file": { "enabled": true, "directory": "logs", "rotation": "daily" } },
    "game": { "fixedUpdateMs": 50, "maxCatchUpSteps": 2 },
    "persistence": {
      "dbProxy": {
        "endpoint": "127.0.0.1:7800",
        "failoverEndpoints": ["127.0.0.1:7801"],
        "authTokenEnv": "TIANGZ_DBPROXY_AUTH_TOKEN",
        "clientPoolSize": 2,
        "connectTimeoutMs": 5000,
        "requestTimeoutMs": 5000,
        "maxFrameBytes": 8388608
      }
    },
    "debug": { "inspectorIp": "127.0.0.1", "inspectorPort": 19239, "breakOnStart": false },
    "observability": {
      "health": { "ip": "127.0.0.1", "port": 17609 },
      "latency": { "enabled": true, "sampleRate": 10 },
      "tracing": { "enabled": true, "sampleRate": 10, "otlpEndpoint": "http://127.0.0.1:4318/v1/traces" }
    }
  },
  "scenes": [{
    "name": "map_manager",
    "sceneType": "MapManager",
    "innerIp": "127.0.0.1",
    "bindIp": "127.0.0.1",
    "port": 17100,
    "protocol": "tcp",
    "audience": "inner"
  }],
  "knownSceneFiles": ["known-scenes.json"]
}
