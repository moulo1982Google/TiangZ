[Unit]
Description=TiangZ external multiprocess runtime
After=network-online.target tiangz-dbproxy@1.service tiangz-dbproxy@2.service
# 两个DBProxy是故障切换候选，任一实例退出都不能连带停止TiangZ。
# Both DBProxy peers are failover candidates; losing either peer must not stop TiangZ.
Wants=network-online.target tiangz-dbproxy@1.service tiangz-dbproxy@2.service

[Service]
Type=simple
User=tiangz
Group=tiangz
WorkingDirectory=/opt/tiangz-external
EnvironmentFile=/etc/tiangz/external.env
ExecStart=/bin/sh -c 'tail -f /dev/null | exec /opt/tiangz-external/TiangZ configs/deploy/external-multiprocess/StartMachine.json'
KillMode=control-group
Restart=on-failure
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
