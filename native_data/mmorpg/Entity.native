// namespace demo is a persisted schema identifier; keep it stable while the source folder follows the MMORPG domain.
// namespace demo 是持久化 schema 标识；物理目录迁移到 MMORPG 后仍保持不变，避免旧快照失效。
namespace demo;

abstract entity Entity {
  @hot
  readonly id: u32;
  @cold
  @transient
  readonly instanceId: u32;
}
