// namespace demo is a persisted schema identifier; keep it stable while the source folder follows the MMORPG domain.
// namespace demo 是持久化 schema 标识；物理目录迁移到 MMORPG 后仍保持不变，避免旧快照失效。
namespace demo;

@typeId(1)
@component
@replicated
entity Unit extends Entity {
  @cold
  readonly mapId: u32;
  @memberId(1)
  @hot
  x: f32 = 0;
  @memberId(2)
  @hot
  y: f32 = 0;
  @memberId(3)
  @hot
  z: f32 = 0;
  @memberId(4)
  @hot
  yaw: f32 = 0;
  @hot
  cellX: i32 = 0;
  @hot
  cellZ: i32 = 0;
  @hot
  targetCellX: i32 = 0;
  @hot
  targetCellZ: i32 = 0;
  @hot
  moveStartTick: u32 = 0;
  @hot
  moveEndTick: u32 = 0;
  @hot
  moving: u32 = 0;
  @hot
  facing: u32 = 0;
  @memberId(5)
  @hot
  speedCellsPerSecond: f32 = 10;
  @memberId(6)
  @cold
  alive: u32 = 1;
  @hot
  inputX: i8 = 0;
  @hot
  inputZ: i8 = 0;
  @hot
  inputChanged: u32 = 0;
  @hot
  sequence: u32 = 0;
}
