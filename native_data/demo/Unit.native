namespace demo;

@typeId(1)
@component
entity Unit extends Entity {
  readonly mapId: u32;
  x: f32 = 0;
  y: f32 = 0;
  cellX: i32 = 0;
  cellY: i32 = 0;
  targetCellX: i32 = 0;
  targetCellY: i32 = 0;
  moveStartTick: u32 = 0;
  moveEndTick: u32 = 0;
  moving: u32 = 0;
  speedCellsPerSecond: f32 = 10;
  inputX: i8 = 0;
  inputY: i8 = 0;
  inputChanged: u32 = 0;
  sequence: u32 = 0;
}
