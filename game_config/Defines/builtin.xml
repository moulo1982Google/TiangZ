<module name="">
    <enum name="SpatialMode" comment="地图空间实现">
        <var name="Grid2D" value="1"/>
        <var name="NavMesh3D" value="2"/>
    </enum>
    <enum name="ConfigReloadMode" comment="配置表运行时重载策略">
        <var name="Hot" value="1"/>
        <var name="Cold" value="2"/>
    </enum>
    <enum name="BuffStackScope" comment="Buff冲突键的来源范围">
        <var name="Target" value="1"/>
        <var name="Source" value="2"/>
    </enum>
    <enum name="BuffConflictPolicy" comment="命中同一Buff冲突键时的决策">
        <var name="Stack" value="1"/>
        <var name="Refresh" value="2"/>
        <var name="Replace" value="3"/>
        <var name="Reject" value="4"/>
        <var name="HigherWins" value="5"/>
    </enum>
    <enum name="BuffRefreshTickPolicy" comment="刷新Buff时的Tick时间轴处理">
        <var name="KeepCadence" value="1"/>
        <var name="ResetCadence" value="2"/>
    </enum>
    <enum name="BuffRefreshStatePolicy" comment="刷新Buff时的运行状态处理">
        <var name="Keep" value="1"/>
        <var name="Reset" value="2"/>
    </enum>
    <enum name="ActionType" comment="道具、Buff和技能共用的原子效果类型">
        <var name="None" value="0"/>
        <var name="ChangeNumeric" value="1"/>
        <var name="AddBuff" value="2"/>
        <var name="RemoveBuff" value="3"/>
        <var name="DealDamage" value="4"/>
        <var name="RegisterDamageAbsorber" value="5"/>
        <var name="Heal" value="6"/>
        <var name="GrantItem" value="7"/>
        <var name="HealFromResolvedDamagePercent" value="8"/>
        <var name="Max" value="9"/>
    </enum>
    <enum name="QuestObjectiveType" comment="任务目标类型">
        <var name="KillMonster" value="1"/>
        <var name="UseItem" value="2"/>
        <var name="EnterMap" value="3"/>
        <var name="CollectItem" value="4"/>
    </enum>
    <enum name="QuestStatus" comment="进行中任务的状态">
        <var name="InProgress" value="1"/>
        <var name="ReadyToTurnIn" value="2"/>
    </enum>
    <enum name="SkillTargetRelation" comment="技能目标关系">
        <var name="Enemy" value="1"/>
        <var name="Friendly" value="2"/>
    </enum>
    <enum name="SkillDelivery" comment="技能命中方式">
        <var name="Direct" value="1"/>
        <var name="Projectile" value="2"/>
    </enum>
    <enum name="SkillEffectTarget" comment="技能效果目标">
        <var name="Caster" value="1"/>
        <var name="PrimaryTarget" value="2"/>
    </enum>
    <enum name="SkillMovementPolicy" comment="施法期间的移动规则">
        <var name="Allow" value="1"/>
        <var name="InterruptWhileCasting" value="2"/>
    </enum>
    <enum name="SkillAutoAttackPolicy" comment="技能与普通攻击时间线的关系">
        <var name="Keep" value="1"/>
        <var name="ResetOnStart" value="2"/>
        <var name="ResetOnComplete" value="3"/>
        <var name="Cancel" value="4"/>
    </enum>
    <bean name="vector2" valueType="1" sep=",">
        <var name="x" type="float"/>
        <var name="y" type="float"/>
    </bean>
</module>
