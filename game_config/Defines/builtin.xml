<module name="">
    <enum name="SpatialMode" comment="地图空间实现">
        <var name="Grid2D" value="1"/>
        <var name="NavMesh3D" value="2"/>
    </enum>
    <enum name="ConfigReloadMode" comment="配置表运行时重载策略">
        <var name="Hot" value="1"/>
        <var name="Cold" value="2"/>
    </enum>
    <enum name="BuffStackScope" comment="Buff冲突键的来源范围">
        <var name="Target" value="1"/>
        <var name="Source" value="2"/>
    </enum>
    <enum name="BuffConflictPolicy" comment="命中同一Buff冲突键时的决策">
        <var name="Stack" value="1"/>
        <var name="Refresh" value="2"/>
        <var name="Replace" value="3"/>
        <var name="Reject" value="4"/>
        <var name="HigherWins" value="5"/>
    </enum>
    <enum name="BuffRefreshTickPolicy" comment="刷新Buff时的Tick时间轴处理">
        <var name="KeepCadence" value="1"/>
        <var name="ResetCadence" value="2"/>
    </enum>
    <enum name="BuffRefreshStatePolicy" comment="刷新Buff时的运行状态处理">
        <var name="Keep" value="1"/>
        <var name="Reset" value="2"/>
    </enum>
    <bean name="vector2" valueType="1" sep=",">
        <var name="x" type="float"/>
        <var name="y" type="float"/>
    </bean>
</module>
