{
  "serverBundles": {
    "sceneSearchRoots": ["app/model/demo"],
    "handlerSearchRoots": ["app/hotfix/demo"],
    "patchSearchRoots": ["app/hotfix/demo"],
    "benchHandlerSearchRoots": ["app/hotfix/bench"],
    "serverProtocolSearchRoots": ["app/generated/model/server/demo"]
  },
  "typescriptClientSdk": {
    "enabled": true,
    "sourceRoot": "client_sdk/typescript",
    "distributionExcludes": ["Generated/Model/bench"],
    "outputRoots": [
      "cocos_client2D/assets/scripts/Generated/SDK",
      "cocos_client3D/assets/scripts/Generated/SDK",
      "pixi_client/src/Generated/SDK"
    ]
  },
  "clientHotfix": {
    "enabled": true,
    "targets": [
      {
        "name": "cocos",
        "handlerSearchRoots": ["cocos_client2D/assets/scripts"],
        "handlerOutput": "cocos_client2D/assets/scripts/Generated/Hotfix/handlers.ts"
      },
      {
        "name": "pixi",
        "handlerSearchRoots": ["pixi_client/src"],
        "handlerOutput": "pixi_client/src/Generated/Hotfix/handlers.ts"
      }
    ]
  }
}
