{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": true,
    "outDir": "dist",
    "rootDir": "app",
    "skipLibCheck": true
  },
  "include": ["app/**/*.ts"]
}
